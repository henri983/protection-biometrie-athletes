# Configuration Environnement
APP_ENV=development
LOG_LEVEL=INFO

# Clé Maître de Chiffrement Biométrique (256-bit AES-GCM en hexadécimal, 64 caractères)
BIOMETRIC_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Clé de signature HMAC d'intégrité des flux télémétriques
HMAC_TELEMETRY_KEY_HEX=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# Tolérance Vitesse Maximale pour Voyage Impossible (km/h)
MAX_PLAUSIBLE_SPEED_KMH=900.0

# Seuil de Risque IA Déclencheur d'Alerte (0.0 à 1.0)
AI_ANOMALY_THRESHOLD=0.75
